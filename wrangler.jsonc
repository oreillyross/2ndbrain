{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2ndbrain",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",

  // workers.dev hostname is protected by one-click Cloudflare Access.
  // Preview URLs are a separate public entrypoint: keep them off.
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/trpc/*"]
  },

  // Non-secret config. Fill in after creating the Access application.
  // Secrets (set with `wrangler secret put`): TURSO_DATABASE_URL, TURSO_AUTH_TOKEN.
  // Never put ENVIRONMENT or DEV_EMAIL here; they belong in .dev.vars only.
  "vars": {
    "TEAM_DOMAIN": "",
    "POLICY_AUD": "",
    "ALLOWED_EMAILS": ""
  },

  "observability": { "enabled": true }
}
