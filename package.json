    "@trpc/react-query": "^11.13.4",
    "@trpc/server": "^11.13.4",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "lucide-react": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "vite": "^8.0.2",
    "wouter": "^3.9.0",
    "zod": "^4.3.6"
